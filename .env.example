# =====================================================================
# OpsPilot Root Environment Configuration Example
# Multi-Tenant Enterprise Operations & Workforce Management SaaS
# =====================================================================

NODE_ENV=development
PORT=5000
CLIENT_PORT=5173

# ---------------------------------------------------------------------
# Frontend Environment Variables (Vite Public Safe)
# CRITICAL SECURITY RULE: NEVER place SUPABASE_SERVICE_ROLE_KEY or database
# credentials in client environments! Only public anonymous keys belong here.
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=https://mock-opspilot.supabase.co
VITE_SUPABASE_ANON_KEY=mock-anon-key-opspilot-2026
VITE_API_URL=http://localhost:5000/api

# ---------------------------------------------------------------------
# Backend Environment Variables (Private & Secure Server Only)
# ---------------------------------------------------------------------
SUPABASE_URL=https://mock-opspilot.supabase.co
SUPABASE_ANON_KEY=mock-anon-key-opspilot-2026
# Admin Client Key: Used exclusively by Node.js server to bypass RLS for background workers
SUPABASE_SERVICE_ROLE_KEY=mock-service-role-key-opspilot-2026
# JWT Secret: Used by Express middleware to cryptographically verify user JWT tokens
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# ---------------------------------------------------------------------
# PostgreSQL Connection Strings
# Local CLI / Direct connection (Port 5432 or 54322)
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
# Supabase Transaction Pooler (PgBouncer port 6543 in hosted production):
# DATABASE_POOLER_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
