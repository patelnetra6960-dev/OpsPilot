# =====================================================================
# OpsPilot Root Environment Configuration Example
# =====================================================================

NODE_ENV=development
PORT=5000
CLIENT_PORT=5173

# Frontend Environment Variables (Publicly Safe)
# Under NO circumstances should SUPABASE_SERVICE_ROLE_KEY ever be placed in the client!
VITE_SUPABASE_URL=https://mock-opspilot.supabase.co
VITE_SUPABASE_ANON_KEY=mock-anon-key-opspilot-2026
VITE_API_URL=http://localhost:5000/api

# Backend Environment Variables (Private & Secure)
SUPABASE_URL=https://mock-opspilot.supabase.co
SUPABASE_ANON_KEY=mock-anon-key-opspilot-2026
SUPABASE_SERVICE_ROLE_KEY=mock-service-role-key-opspilot-2026

# PostgreSQL Connection String (Optional for direct CLI migrations)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
