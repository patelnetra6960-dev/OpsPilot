# =====================================================================
# OpsPilot Server Environment Variables
# Private & Secure Backend Configuration
# =====================================================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------
# Supabase Backend Credentials
# WARNING: NEVER expose SUPABASE_SERVICE_ROLE_KEY to the frontend client!
# ---------------------------------------------------------------------
SUPABASE_URL=https://mock-opspilot.supabase.co
SUPABASE_ANON_KEY=mock-anon-key-opspilot-2026
SUPABASE_SERVICE_ROLE_KEY=mock-service-role-key-opspilot-2026
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# ---------------------------------------------------------------------
# PostgreSQL Connection Strings
# Direct connection for migrations (Local port 54322, Cloud port 5432)
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
# Transaction Pooler (Hosted Production Port 6543)
# DATABASE_POOLER_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
