{
  "name": "opspilot-monorepo",
  "version": "1.0.0",
  "description": "OpsPilot — Multi-tenant Enterprise Operations & Workforce Management SaaS",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "node scripts/dev.js",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:client",
    "test:server": "npm --prefix server test",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:integration": "node --test tests/integration/**/*.test.js",
    "test": "npm run test:unit && npm run test:server && npm run test:integration",
    "check:env": "node scripts/check-env.js",
    "migrate": "node server/src/database/migrate.js",
    "check:scope": "node scripts/check-undeclared.js",
    "lint": "eslint . && node scripts/check-undeclared.js",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md}\""
  },
  "keywords": [
    "multi-tenant",
    "saas",
    "workforce-management",
    "react",
    "express",
    "supabase",
    "postgresql",
    "rls"
  ],
  "author": "OpsPilot Core Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "eslint": "^9.20.0",
    "prettier": "^3.5.1"
  }
}
